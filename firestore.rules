rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == "nutrifyfitlk@gmail.com" && request.auth.token.email_verified == true);
    }

    // Batch Validation
    function isValidBatch(data) {
      return data.industry is string &&
             data.city is string &&
             data.country is string &&
             data.platforms is list &&
             data.emotionHook is string &&
             data.batchSize is number &&
             data.content is map &&
             data.userId is string &&
             data.timestamp is timestamp;
    }

    match /batches/{batchId} {
      allow get: if true;
      allow list: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated() && isValidBatch(request.resource.data) && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /stats/global {
      allow read: if isAuthenticated();
      allow update: if isAuthenticated();
      allow create, delete: if isAdmin();
    }
  }
}
